# 本地工作与工具产物（不入库）
.workbuddy/
.idea/
*.iml
.DS_Store
Thumbs.db

# 构建/依赖兜底（子项目内 .gitignore 之外）
node_modules/
target/
dist/
*.local

# ── 私密配置：含真实凭据，永不提交 ──────────────────
# Spring 本地配置（真库地址、密码、API key 都在这）
application-local.yaml
application-local.yml
application-*-local.yaml
application-*-local.yml
# 环境变量文件（保留 .env.development / .env.production 这两个空模板）
.env
.env.local
.env.*.local
